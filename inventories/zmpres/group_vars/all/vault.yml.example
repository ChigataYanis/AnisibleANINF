---
# Copier en vault.yml, renseigner, puis chiffrer :
#   cp vault.yml.example vault.yml && ansible-vault encrypt vault.yml
# Aucun mot de passe ne doit rester en clair dans le dépôt.
vault_zimbra_admin_password: "CHANGER-MOI"
vault_zimbra_ldap_password: "CHANGER-MOI"
# Commande d'activation de la licence sur le nœud LDS (Q12), voir roles/zimbra_lds.
vault_zimbra_license_key: ""
