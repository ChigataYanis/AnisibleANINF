HOSTNAME="{{ zimbra_fqdn }}"
zimbraIPMode="ipv4"
LDAPHOST="{{ zimbra_first_ldap }}.{{ zimbra_hosts_domain }}"
LDAPPORT="389"
LDAPROOTPASS="{{ zimbra_ldap_password }}"
LDAPADMINPASS="{{ zimbra_ldap_password }}"
LDAPREPPASS="{{ zimbra_ldap_password }}"
LDAPPOSTPASS="{{ zimbra_ldap_password }}"
LDAPAMAVISPASS="{{ zimbra_ldap_password }}"
ldap_nginx_password="{{ zimbra_ldap_password }}"
ldap_bes_searcher_password="{{ zimbra_ldap_password }}"
LDAPBESSEARCHSET="set"
ldap_dit_base_dn_config="cn=zimbra"
zimbra_ldap_userdn="uid=zimbra,cn=admins,cn=zimbra"
AVDOMAIN="{{ zimbra_default_domain }}"
AVUSER="{{ zimbra_admin_account }}"
CREATEDOMAIN="{{ zimbra_default_domain }}"
CREATEADMIN="{{ zimbra_admin_account }}"
CREATEADMINPASS="{{ zimbra_admin_password }}"
{# Domaine : dès le premier annuaire. Compte admin : il faut un stockage de
   boîtes, donc le premier serveur de boîtes (sur un LDAP seul, zmsetup saute
   la création sans erreur). Tout-en-un : les deux sur la même machine. #}
DOCREATEDOMAIN="{{ 'yes' if inventory_hostname in [zimbra_first_ldap, zimbra_mailbox_hosts[0]] else 'no' }}"
DOCREATEADMIN="{{ 'yes' if inventory_hostname == zimbra_mailbox_hosts[0] else 'no' }}"
DOTRAINSA="no"
SMTPHOST="{{ zimbra_smtp_hosts | join(' ') }}"
SMTPSOURCE="{{ zimbra_admin_account }}"
SMTPDEST="{{ zimbra_admin_account }}"
SMTPNOTIFY="yes"
SNMPNOTIFY="no"
zimbraMtaMyNetworks="{{ zimbra_mta_mynetworks }}"
zimbraPrefTimeZoneId="{{ zimbra_timezone }}"
VERSIONUPDATECHECKS="FALSE"
zimbraVersionCheckSendNotifications="FALSE"
ZIMBRA_REQ_SECURITY="yes"
zimbra_require_interprocess_security="1"
ssl_default_digest="sha256"
STARTSERVERS="yes"
{% for key, value in (zimbra_setup_extra | combine(zimbra_setup_lds)).items() %}
{{ key }}="{{ value }}"
{% endfor %}
INSTALL_PACKAGES="zimbra-core {{ _zimbra_packages_all | join(' ') }}"
