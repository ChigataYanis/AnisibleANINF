{% set d = '.' ~ zimbra_hosts_domain %}
{% set mailboxes = zimbra_mailbox_hosts | map('regex_replace', '$', d) | list %}
{% set mtas = zimbra_mta_hosts | map('regex_replace', '$', d) | list %}
{% set proxies = zimbra_proxy_hosts | map('regex_replace', '$', d) | list %}
# Exigences §6.4 de la fiche ANINF — généré par Ansible, rejoué à l'identique.
mc default zimbraPrefTimeZoneId {{ zimbra_timezone }}
{% if fortimail_relay_host | length > 0 %}
mcf zimbraMtaRelayHost {{ fortimail_relay_host }}
{% endif %}
mcf zimbraMtaMyNetworks "{{ zimbra_mta_mynetworks }}"
mcf zimbraMtaLmtpHostLookup {{ 'native' if zimbra_name_resolution == 'hosts' else 'dns' }}
{% for m in mtas %}
ms {{ m }} zimbraMtaMyNetworks "{{ zimbra_mta_mynetworks }}"{% for b in mailboxes %} zimbraMtaAuthHost {{ b }}{% endfor %}

{% endfor %}
mcf{% for s in zimbra_smtp_hosts %} zimbraSmtpHostname {{ s }}{% endfor %}

{% for b in mailboxes %}
ms {{ b }}{% for s in zimbra_smtp_hosts %} zimbraSmtpHostname {{ s }}{% endfor %}

{% endfor %}
{% if zimbra_http_safe_ips | length > 0 %}
mcf{% for ip in zimbra_http_safe_ips %} zimbraHttpThrottleSafeIPs {{ ip }}{% endfor %}

{% endif %}
{% if proxies | length > 0 and zimbra_topology == 'multi' %}
mcf{% for p in zimbra_proxy_hosts %} zimbraMailTrustedIP {{ hostvars[p].zimbra_ip }}{% endfor %}

mcf{% for p in proxies %} zimbraMemcachedClientServerList {{ p }}:11211{% endfor %}

{% for p in proxies %}
ms {{ p }} zimbraReverseProxyMailMode {{ zimbra_proxy_mail_mode }}
{% endfor %}
{% endif %}
{% if zimbra_logger_host | length > 0 %}
mcf zimbraLogHostname {{ zimbra_logger_host }}{{ d }}
{% endif %}
mcf zimbraSpamIsSpamAccount "" zimbraSpamIsNotSpamAccount ""
mcf zimbraMtaPostscreenDnsblSites ""
{% if zimbra_disable_pop3 %}
{% for b in mailboxes %}
ms {{ b }} zimbraPop3ServerEnabled FALSE zimbraPop3SSLServerEnabled FALSE
{% endfor %}
{% endif %}
